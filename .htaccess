# Disable directory browsing
Options -Indexes

<IfModule mod_rewrite.c>
Options +FollowSymlinks
RewriteEngine On

# ----------------------------------------------------------------------
# Security Blockers (Place BEFORE routing rules)
# ----------------------------------------------------------------------
# 1. Block access to hidden dotfiles (.env, .git, etc.)
RedirectMatch 403 "(^|/)\."

# 2. Block direct access to application core folders
RewriteRule ^(app|system|writable) - [F,L]

# ----------------------------------------------------------------------
# CodeIgniter Routing Rules
# ----------------------------------------------------------------------
# Handle root path
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^$ public/index.php [L,QSA]

# Redirect Trailing Slashes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [L,R=301]

# Route front controller requests
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php/$1 [L,NC,QSA]

# Pass Authorization header
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule !mod_rewrite.c>
ErrorDocument 404 index.php
</IfModule>

ServerSignature Off