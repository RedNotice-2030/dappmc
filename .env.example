#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
# Options: development, production, testing
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP SETTINGS
#--------------------------------------------------------------------
app.baseURL = 'https://yourdomain.com/'
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# DATABASE (Aiven MySQL)
#--------------------------------------------------------------------
database.default.hostname = your-aiven-db-host.aivencloud.com
database.default.database = defaultdb
database.default.username = avnadmin
database.default.password = YOUR_AIVEN_DB_PASSWORD_HERE
database.default.DBDriver = MySQLi
database.default.port = 24961

# SSL setup for Aiven (Relative path to project root)
database.default.encrypt = true
database.default.compress = false
database.default.strictOn = false

#--------------------------------------------------------------------
# COOKIE SECURITY
#--------------------------------------------------------------------
cookie.prefix = ''
cookie.expires = 0
cookie.path = '/'
cookie.domain = ''
cookie.secure = true
cookie.httponly = true
cookie.samesite = 'Lax'
cookie.raw = false

#--------------------------------------------------------------------
# EMAIL / SMTP (Google Gmail App Password)
#--------------------------------------------------------------------
email.fromEmail = 'your-email@gmail.com'
email.fromName = 'DAPPMC Cares'
email.SMTPHost = 'smtp.gmail.com'
email.SMTPUser = 'your-email@gmail.com'
email.SMTPPass = 'YOUR_GOOGLE_APP_PASSWORD_HERE'
email.SMTPPort = 587
email.SMTPCrypto = 'tls'
email.mailType = 'html'
email.charset = 'UTF-8'

#--------------------------------------------------------------------
# SECURITY
#--------------------------------------------------------------------
# MySQL error/exception display. Keep OFF in production (default).
# Turn on only for local debugging:
database.default.DBDebug = false

# Comma-separated list of origins allowed to call POST /api/ratings
# from a different domain. Leave empty for same-origin only.
RATE_US_ALLOWED_ORIGIN = ''

# One-time credentials used by `php spark db:seed AdminUserSeeder`.
# If ADMIN_INITIAL_PASSWORD is not set, a random password is printed.
ADMIN_INITIAL_USERNAME = admin
ADMIN_INITIAL_EMAIL = admin@yourdomain.com
ADMIN_INITIAL_PASSWORD = ''